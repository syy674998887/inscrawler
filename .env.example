# Login: fill these values in the GUI or your local .env.
username=
session_cookie=
user_agent=

# Download settings
save_path=
iphone_support=false
profile_picture_sync=false
media_request_cap_enabled=false
patrol_media_type=posts
patrol_page_limit=1

# Notifications: none, system, discord, telegram
notification=
notification_webhook=
telegram_bot_token=
telegram_chat_id=

# Interface
ui_theme=light
ui_language=en
close_behavior=tray
debug_logging=false
video_preview_cache_mb=192
max_preview_images=45
main_preview_visible=true
